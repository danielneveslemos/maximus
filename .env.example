# Maximus v4 — variáveis de deploy (go-live do cliente)

# Domínio canônico de produção — preencher só quando o cliente apontar o domínio dele.
# Sem barra final. Deixe vazio na versão de apresentação / preview.
VITE_SITE_URL=

# Preview / demo: false (não indexar). Go-live: true.
VITE_ALLOW_INDEXING=false
